# Hardening for the public-disk storage directory (symlinked to /storage in
# the docroot). Defence in depth — the upload validator already rejects PHP /
# SVG / HTML, but we want belt-and-braces in case a future change reintroduces
# them or a polyglot file slips past content-type sniffing.

# Refuse to execute any PHP-adjacent extensions even if they land here.
<FilesMatch "\.(php|phar|phtml|phps|pht|html?|svg|xhtml|js|wasm)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Force download for anything that could host script content.
    <FilesMatch "\.(svg|html?|xhtml|xml|wasm|json)$">
        Header always set Content-Disposition "attachment"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
